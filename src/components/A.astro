---
// Один самодостаточный ответ на вопрос, от основ до продакшен-компромиссов.
import { langOf, ui } from '../lib/ui';

const t = ui(langOf(Astro.locals));
---

<div class="ans ans-unified">
  <span class="ans-tag not-content">{t.answer}</span>
  <div class="ans-body">
    <slot />
  </div>
</div>
